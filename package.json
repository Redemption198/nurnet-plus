{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "NUXT_APP_BASE_URL=/nurnet-plus/ nuxt generate",
    "generate-pwa-assets-base": "vp dlx pwa-asset-generator ./app/assets/nurnet-plus.svg ./public/pwa -b 'linear-gradient(to right bottom, #fe8702ff, #d87401ff, #b26100ff)'",
    "generate-pwa-assets": "vp run generate-pwa-assets-base -- --padding 'calc(50vh - 20%) calc(50vw - 25%)'; vp run generate-pwa-assets-icon-only",
    "generate-pwa-assets-icon-only": "vp run generate-pwa-assets-base -- --icon-only",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "vp config"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "fuse.js": "^7.5.0",
    "gsap": "^3.15.0",
    "ol": "^10.11.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "nuxt": "^4.6.3",
    "typescript": "^5.9.3",
    "vite-plus": "catalog:"
  }
}
